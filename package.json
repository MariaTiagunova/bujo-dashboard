{
  "name": "bujo-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Bullet Journal and e-ink personal dashboard. A static page that syncs with Google Calendar and Google Tasks through Apps Script.",
  "type": "module",
  "scripts": {
    "build": "rollup -c && npm run check:es5",
    "dev": "node scripts/dev.js",
    "serve": "node scripts/serve.js",
    "check:es5": "es-check es5 \"dist/*.js\"",
    "test": "node --test \"test/*.test.js\""
  },
  "browserslist": [
    "safari >= 5.1",
    "ios_saf >= 6",
    "android >= 4.4",
    "last 2 chrome versions",
    "last 2 firefox versions",
    "last 2 edge versions"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "core-js": "^3.51.0"
  },
  "devDependencies": {
    "@babel/core": "^8.1.3",
    "@babel/preset-env": "^8.0.7",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "babel-plugin-polyfill-corejs3": "^1.0.0",
    "es-check": "^9.9.0",
    "rollup": "^4.68.8"
  }
}
